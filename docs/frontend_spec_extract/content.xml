hFont" style:family="text"><style:text-properties fo:font-weight="bold" style:font-weight-asian="bold" fo:font-size="13pt" style:font-size-asian="13pt"/></style:style><style:style style:name="T27" style:parent-style-name="DefaultParagraphFont" style:family="text"><style:text-properties fo:font-weight="bold" style:font-weight-asian="bold" fo:font-size="16pt" style:font-size-asian="16pt"/></style:style><style:style style:name="T28" style:parent-style-name="DefaultParagraphFont" style:family="text"><style:text-properties fo:font-weight="bold" style:font-weight-asian="bold" fo:font-size="13pt" style:font-size-asian="13pt"/></style:style><style:style style:name="T29" style:parent-style-name="DefaultParagraphFont" style:family="text"><style:text-properties fo:font-weight="bold" style:font-weight-asian="bold" fo:font-size="13pt" style:font-size-asian="13pt"/></style:style><style:style style:name="T30" style:parent-style-name="DefaultParagraphFont" style:family="text"><style:text-properties fo:font-weight="bold" style:font-weight-asian="bold" fo:font-size="13pt" style:font-size-asian="13pt"/></style:style><style:style style:name="T31" style:parent-style-name="DefaultParagraphFont" style:family="text"><style:text-properties fo:font-weight="bold" style:font-weight-asian="bold" fo:font-size="13pt" style:font-size-asian="13pt"/></style:style><style:style style:name="T32" style:parent-style-name="DefaultParagraphFont" style:family="text"><style:text-properties fo:font-weight="bold" style:font-weight-asian="bold" fo:font-size="16pt" style:font-size-asian="16pt"/></style:style><style:style style:name="T33" style:parent-style-name="DefaultParagraphFont" style:family="text"><style:text-properties fo:font-weight="bold" style:font-weight-asian="bold" fo:font-size="13pt" style:font-size-asian="13pt"/></style:style><style:style style:name="T34" style:parent-style-name="DefaultParagraphFont" style:family="text"><style:text-properties fo:font-weight="bold" style:font-weight-asian="bold" fo:font-size="13pt" style:font-size-asian="13pt"/></style:style><style:style style:name="T35" style:parent-style-name="DefaultParagraphFont" style:family="text"><style:text-properties fo:font-weight="bold" style:font-weight-asian="bold" fo:font-size="16pt" style:font-size-asian="16pt"/></style:style><style:style style:name="T36" style:parent-style-name="DefaultParagraphFont" style:family="text"><style:text-properties fo:font-weight="bold" style:font-weight-asian="bold" fo:font-size="13pt" style:font-size-asian="13pt"/></style:style><style:style style:name="T37" style:parent-style-name="DefaultParagraphFont" style:family="text"><style:text-properties fo:font-weight="bold" style:font-weight-asian="bold" fo:font-size="13pt" style:font-size-asian="13pt"/></style:style><style:style style:name="T38" style:parent-style-name="DefaultParagraphFont" style:family="text"><style:text-properties fo:font-weight="bold" style:font-weight-asian="bold" fo:font-size="16pt" style:font-size-asian="16pt"/></style:style><style:style style:name="T39" style:parent-style-name="DefaultParagraphFont" style:family="text"><style:text-properties fo:font-weight="bold" style:font-weight-asian="bold" fo:font-size="16pt" style:font-size-asian="16pt"/></style:style><style:style style:name="T40" style:parent-style-name="DefaultParagraphFont" style:family="text"><style:text-properties fo:font-weight="bold" style:font-weight-asian="bold" fo:font-size="13pt" style:font-size-asian="13pt"/></style:style><style:style style:name="T41" style:parent-style-name="DefaultParagraphFont" style:family="text"><style:text-properties fo:font-weight="bold" style:font-weight-asian="bold" fo:font-size="13pt" style:font-size-asian="13pt"/></style:style><style:style style:name="T42" style:parent-style-name="DefaultParagraphFont" style:family="text"><style:text-properties fo:font-weight="bold" style:font-weight-asian="bold" fo:font-size="16pt" style:font-size-asian="16pt"/></style:style><style:style style:name="T43" style:parent-style-name="DefaultParagraphFont" style:family="text"><style:text-properties fo:font-weight="bold" style:font-weight-asian="bold" fo:font-size="16pt" style:font-size-asian="16pt"/></style:style><style:style style:name="T44" style:parent-style-name="DefaultParagraphFont" style:family="text"><style:text-properties fo:font-weight="bold" style:font-weight-asian="bold" fo:font-size="16pt" style:font-size-asian="16pt"/></style:style></office:automatic-styles><office:body><office:text text:use-soft-page-breaks="true"><text:p text:style-name="P1"><text:span text:style-name="T2">Middle School Portal — Frontend (Angular) Copilot Build Spec</text:span></text:p><text:p text:style-name="P3"><text:span text:style-name="T4">(Angular TypeScript • Responsive • Role-based Dashboards • API Integration)</text:span></text:p><text:p text:style-name="Normal"/><text:p text:style-name="Normal"><text:span text:style-name="T5">Version: 1.0</text:span><text:span text:style-name="T6"><text:line-break/>Date: 2026-05-09</text:span><text:span text:style-name="T7"><text:line-break/></text:span><text:span text:style-name="T8">Audience: Developers using GitHub Copilot / M365 Copilot (IntelliJ + VS Code)</text:span></text:p><text:p text:style-name="Normal"><text:span text:style-name="T9">1) Purpose &amp; Scope</text:span></text:p><text:p text:style-name="Normal">Build a responsive Angular single-page application (SPA) for a single middle school portal. The UI supports Admin, Teacher, Student, and Guardian users, each with a dashboard and role-scoped features: homework viewing/submission, announcements, documents, quizzes (phase 2), and basic profile management.</text:p><text:p text:style-name="Normal"><text:span text:style-name="T10">Non-Functional Requirements</text:span></text:p><text:list text:style-name="LFO1" text:continue-numbering="true"><text:list-item><text:p text:style-name="ListBullet">Mobile-first responsive design; must work well on phones, tablets, and desktops.</text:p></text:list-item><text:list-item><text:p text:style-name="ListBullet">Accessibility: semantic HTML, keyboard navigation, sufficient contrast; use ARIA where needed.</text:p></text:list-item><text:list-item><text:p text:style-name="ListBullet">Security: JWT access token attached to API calls; protect routes with role guards; prevent IDOR with server-side checks (frontend also hides UI).</text:p></text:list-item><text:list-item><text:p text:style-name="ListBullet">Performance: lazy-load feature modules; avoid heavy bundles; use OnPush where appropriate.</text:p></text:list-item><text:list-item><text:p text:style-name="ListBullet">Audit and email notifications are backend responsibilities; frontend must display event outcomes and errors cleanly.</text:p></text:list-item></text:list><text:p text:style-name="Normal"><text:span text:style-name="T11">2) UI Library &amp; Styling (Choose one)</text:span></text:p><text:p text:style-name="Normal">Either library works. Select one for consistent components and responsive layout:</text:p><text:list text:style-name="LFO1" text:continue-numbering="true"><text:list-item><text:p text:style-name="ListBullet">Option A: Angular Material (clean, accessible, good mobile).</text:p></text:list-item><text:list-item><text:p text:style-name="ListBullet">Option B: PrimeNG (rich tables, dashboards, data grids).</text:p></text:list-item></text:list><text:p text:style-name="Normal">Recommendation: If you expect many tables and filters, use PrimeNG. If you want default accessibility and a cohesive look, use Angular Material.</text:p><text:p text:style-name="Normal"><text:span text:style-name="T12">3) App Information Architecture (Roles &amp; Navigation)</text:span></text:p><text:p text:style-name="Normal"><text:span text:style-name="T13">Top-level navigation rules</text:span></text:p><text:soft-page-break/><text:list text:style-name="LFO1" text:continue-numbering="true"><text:list-item><text:p text:style-name="ListBullet">After login, route user to dashboard based on primary role: /admin, /teacher, /student, /guardian.</text:p></text:list-item><text:list-item><text:p text:style-name="ListBullet">Use a shared AppShell layout with responsive side nav (desktop) and bottom/overflow menu (mobile).</text:p></text:list-item><text:list-item><text:p text:style-name="ListBullet">Show only menu items allowed by role; do not expose admin/teacher routes in UI for other roles.</text:p></text:list-item></text:list><text:p text:style-name="Normal"><text:span text:style-name="T14">Dashboards &amp; Pages</text:span></text:p><text:p text:style-name="Normal">Admin Dashboard</text:p><text:list text:style-name="LFO1" text:continue-numbering="true"><text:list-item><text:p text:style-name="ListBullet">User management (create/update/deactivate)</text:p></text:list-item><text:list-item><text:p text:style-name="ListBullet">Class management (create classes, assign teacher)</text:p></text:list-item><text:list-item><text:p text:style-name="ListBullet">Enrollment (add students to class)</text:p></text:list-item><text:list-item><text:p text:style-name="ListBullet">Link guardian ↔ student</text:p></text:list-item><text:list-item><text:p text:style-name="ListBullet">School announcements</text:p></text:list-item><text:list-item><text:p text:style-name="ListBullet">Audit log viewer (read-only)</text:p></text:list-item></text:list><text:p text:style-name="Normal">Teacher Dashboard</text:p><text:list text:style-name="LFO1" text:continue-numbering="true"><text:list-item><text:p text:style-name="ListBullet">My classes</text:p></text:list-item><text:list-item><text:p text:style-name="ListBullet">Homework CRUD (create/list/details)</text:p></text:list-item><text:list-item><text:p text:style-name="ListBullet">Submissions list and details</text:p></text:list-item><text:list-item><text:p text:style-name="ListBullet">Class announcements</text:p></text:list-item><text:list-item><text:p text:style-name="ListBullet">Documents upload (optional)</text:p></text:list-item></text:list><text:p text:style-name="Normal">Student Dashboard</text:p><text:list text:style-name="LFO1" text:continue-numbering="true"><text:list-item><text:p text:style-name="ListBullet">My homework list (by class) + status chips</text:p></text:list-item><text:list-item><text:p text:style-name="ListBullet">Homework detail + submit</text:p></text:list-item><text:list-item><text:p text:style-name="ListBullet">Announcements feed</text:p></text:list-item><text:list-item><text:p text:style-name="ListBullet">Documents list + download</text:p></text:list-item><text:list-item><text:p text:style-name="ListBullet">Quizzes (phase 2)</text:p></text:list-item><text:list-item><text:p text:style-name="ListBullet">Profile</text:p></text:list-item></text:list><text:p text:style-name="Normal">Guardian Dashboard</text:p><text:list text:style-name="LFO1" text:continue-numbering="true"><text:list-item><text:p text:style-name="ListBullet">Select linked student (if multiple)</text:p></text:list-item><text:list-item><text:p text:style-name="ListBullet">Child homework status + submissions</text:p></text:list-item><text:list-item><text:p text:style-name="ListBullet">Announcements feed</text:p></text:list-item><text:list-item><text:p text:style-name="ListBullet">Documents list + download</text:p></text:list-item><text:list-item><text:p text:style-name="ListBullet">Profile</text:p></text:list-item></text:list><text:p text:style-name="Normal"><text:span text:style-name="T15">4) Angular Project Setup</text:span></text:p><text:p text:style-name="Normal"><text:span text:style-name="T16">Angular version &amp; tooling</text:span></text:p><text:list text:style-name="LFO1" text:continue-numbering="true"><text:list-item><text:p text:style-name="ListBullet">Angular 17+ recommended (standalone APIs optional).</text:p></text:list-item><text:list-item><text:p text:style-name="ListBullet">TypeScript strict mode enabled.</text:p></text:list-item><text:list-item><text:p text:style-name="ListBullet">ESLint + Prettier for formatting and linting.</text:p></text:list-item><text:list-item><text:p text:style-name="ListBullet">Environment files: environment.ts / environment.prod.ts with apiBaseUrl.</text:p></text:list-item></text:list><text:p text:style-name="Normal"><text:span text:style-name="T17">Folder structure (recommended)</text:span></text:p><text:p text:style-name="Normal">Use a scalable feature-based structure:</text:p><text:list text:style-name="LFO1" text:continue-numbering="true"><text:list-item><text:p text:style-name="ListBullet">src/app/core (auth, guards, interceptors, app shell, config)</text:p></text:list-item><text:list-item><text:p text:style-name="ListBullet">src/app/shared (reusable components, pipes, directives, ui wrappers)</text:p></text:list-item><text:list-item><text:p text:style-name="ListBullet">src/app/features/admin (lazy-loaded)</text:p></text:list-item><text:list-item><text:p text:style-name="ListBullet">src/app/features/teacher (lazy-loaded)</text:p></text:list-item><text:list-item><text:p text:style-name="ListBullet">src/app/features/student (lazy-loaded)</text:p></text:list-item><text:list-item><text:p text:style-name="ListBullet">src/app/features/guardian (lazy-loaded)</text:p></text:list-item></text:list><text:p text:style-name="Normal"><text:span text:style-name="T18">Routing &amp; Lazy Loading</text:span></text:p><text:list text:style-name="LFO1" text:continue-numbering="true"><text:list-item><text:p text:style-name="ListBullet">Use top-level routes for each role and lazy-load the feature module or route config.</text:p></text:list-item><text:list-item><text:p text:style-name="ListBullet">Add guards: AuthGuard (logged-in), RoleGuard (role-based), and optional StudentContextGuard (guardian chosen student).</text:p></text:list-item><text:list-item><text:p text:style-name="ListBullet">Provide a NotFound page and an Unauthorized page.</text:p></text:list-item></text:list><text:p text:style-name="Normal"><text:span text:style-name="T19">5) Authentication UX &amp; Client Security</text:span></text:p><text:p text:style-name="Normal"><text:span text:style-name="T20">Auth flow (JWT access + refresh)</text:span></text:p><text:list text:style-name="LFO1" text:continue-numbering="true"><text:list-item><text:p text:style-name="ListBullet">Login page posts credentials to /api/auth/login, receives accessToken + refreshToken.</text:p></text:list-item><text:list-item><text:p text:style-name="ListBullet">Store access token in memory (preferred) or sessionStorage; store refresh token in HttpOnly cookie if backend supports it; otherwise store in secure storage with care.</text:p></text:list-item><text:list-item><text:p text:style-name="ListBullet">Use an HttpInterceptor to attach Authorization: Bearer &lt;accessToken&gt; to API requests.</text:p></text:list-item><text:list-item><text:p text:style-name="ListBullet">On 401, attempt refresh once using /api/auth/refresh; retry original request; on failure route to /login.</text:p></text:list-item><text:list-item><text:p text:style-name="ListBullet">Logout clears client state and calls /api/auth/logout to revoke refresh token.</text:p></text:list-item></text:list><text:p text:style-name="Normal"><text:span text:style-name="T21">Guards &amp; Authorization</text:span></text:p><text:list text:style-name="LFO1" text:continue-numbering="true"><text:list-item><text:p text:style-name="ListBullet">AuthGuard: blocks unauthenticated navigation.</text:p></text:list-item><text:list-item><text:p text:style-name="ListBullet">RoleGuard: enforces ADMIN/TEACHER/STUDENT/GUARDIAN route access.</text:p></text:list-item><text:list-item><text:p text:style-name="ListBullet">UI must hide/disable unauthorized actions, but backend remains authoritative.</text:p></text:list-item></text:list><text:p text:style-name="Normal"><text:span text:style-name="T22">Login, Forgot Password, Reset Password Screens</text:span></text:p><text:list text:style-name="LFO1" text:continue-numbering="true"><text:list-item><text:p text:style-name="ListBullet">Login: email/password, remember me optional.</text:p></text:list-item><text:list-item><text:p text:style-name="ListBullet">Forgot password: collect email, show confirmation message.</text:p></text:list-item><text:list-item><text:p text:style-name="ListBullet">Reset password: token + new password + confirm.</text:p></text:list-item></text:list><text:p text:style-name="Normal"><text:span text:style-name="T23">6) API Integration Pattern</text:span></text:p><text:p text:style-name="Normal"><text:span text:style-name="T24">HTTP service layering</text:span></text:p><text:list text:style-name="LFO1" text:continue-numbering="true"><text:list-item><text:p text:style-name="ListBullet">Create a typed ApiClient wrapper around HttpClient (base URL, common error handling).</text:p></text:list-item><text:list-item><text:p text:style-name="ListBullet">Create feature services: HomeworkService, AnnouncementService, DocumentService, AdminUserService, ClassService, QuizService.</text:p></text:list-item><text:list-item><text:p text:style-name="ListBullet">Define DTO interfaces under each feature or in shared/models (avoid circular deps).</text:p></text:list-item><text:list-item><text:p text:style-name="ListBullet">Use RxJS with error handling and loading states; standardize responses.</text:p></text:list-item></text:list><text:p text:style-name="Normal"><text:span text:style-name="T25">Error Handling &amp; UX</text:span></text:p><text:list text:style-name="LFO1" text:continue-numbering="true"><text:list-item><text:p text:style-name="ListBullet">Use a global error handler or interceptor to map API errors to user-friendly messages.</text:p></text:list-item><text:list-item><text:p text:style-name="ListBullet">Show toast/snackbar notifications on success/failure.</text:p></text:list-item><text:list-item><text:p text:style-name="ListBullet">Implement loading indicators for list/detail pages and upload/download actions.</text:p></text:list-item></text:list><text:p text:style-name="Normal"><text:span text:style-name="T26">DTO examples (high level)</text:span></text:p><text:list text:style-name="LFO1" text:continue-numbering="true"><text:list-item><text:p text:style-name="ListBullet">LoginResponse: { accessToken: string; refreshToken: string; userId: string; }</text:p></text:list-item><text:list-item><text:p text:style-name="ListBullet">Homework: { id; classId; title; description; dueDate; attachments[]; createdAt; }</text:p></text:list-item><text:list-item><text:p text:style-name="ListBullet">Submission: { id; homeworkId; studentId; status; submittedAt; files[]; }</text:p></text:list-item><text:list-item><text:p text:style-name="ListBullet">Announcement: { id; scope; scopeId?; title; body; createdAt; }</text:p></text:list-item><text:list-item><text:p text:style-name="ListBullet">DocumentMetadata: { id; ownerType; ownerId; fileName; size; uploadedAt; }</text:p></text:list-item></text:list><text:p text:style-name="Normal"><text:span text:style-name="T27">7) Feature Specs (MVP)</text:span></text:p><text:p text:style-name="Normal"><text:span text:style-name="T28">A) Admin — Users, Classes, Enrollment, Links</text:span></text:p><text:p text:style-name="Normal">Admin pages:</text:p><text:list text:style-name="LFO1" text:continue-numbering="true"><text:list-item><text:p text:style-name="ListBullet">Users List: searchable, filter by role, status; create user dialog; edit/deactivate.</text:p></text:list-item><text:list-item><text:p text:style-name="ListBullet">Classes: list/create/update; assign teacher to class.</text:p></text:list-item><text:list-item><text:p text:style-name="ListBullet">Enrollment: add/remove students to classes (simple multi-select).</text:p></text:list-item><text:list-item><text:p text:style-name="ListBullet">Guardian Links: link/unlink guardian to student; show linked students per guardian.</text:p></text:list-item><text:list-item><text:p text:style-name="ListBullet">Audit Logs: read-only list with filters (date range, user, action).</text:p></text:list-item></text:list><text:p text:style-name="Normal"><text:span text:style-name="T29">B) Teacher — Homework &amp; Submissions</text:span></text:p><text:p text:style-name="Normal">Teacher pages:</text:p><text:list text:style-name="LFO1" text:continue-numbering="true"><text:list-item><text:p text:style-name="ListBullet">My Classes: list cards or table with quick actions.</text:p></text:list-item><text:list-item><text:p text:style-name="ListBullet">Homework List: filter by class; status; sort by due date.</text:p></text:list-item><text:list-item><text:p text:style-name="ListBullet">Create Homework: form with validation; attachments upload; due date picker.</text:p></text:list-item><text:list-item><text:p text:style-name="ListBullet">Homework Detail: view homework + attachments; link to submissions.</text:p></text:list-item><text:list-item><text:p text:style-name="ListBullet">Submissions List: per homework; show student name, submittedAt, status; open submission detail.</text:p></text:list-item><text:list-item><text:p text:style-name="ListBullet">Submission Detail: view files and text; optional feedback/grade.</text:p></text:list-item></text:list><text:p text:style-name="Normal"><text:span text:style-name="T30">C) Student — Homework &amp; Submission</text:span></text:p><text:p text:style-name="Normal">Student pages:</text:p><text:list text:style-name="LFO1" text:continue-numbering="true"><text:list-item><text:p text:style-name="ListBullet">Homework List: grouped by class or tabs; show status (Not started / Submitted / Late).</text:p></text:list-item><text:list-item><text:p text:style-name="ListBullet">Homework Detail: description, attachments, due date; submit action.</text:p></text:list-item><text:list-item><text:p text:style-name="ListBullet">Submit Homework: text area + file upload; show submission confirmation.</text:p></text:list-item><text:list-item><text:p text:style-name="ListBullet">Announcements Feed: latest school/class announcements with pagination.</text:p></text:list-item><text:list-item><text:p text:style-name="ListBullet">Documents: list with download button; show file name/size/date.</text:p></text:list-item></text:list><text:p text:style-name="Normal"><text:span text:style-name="T31">D) Guardian — Student selector &amp; monitoring</text:span></text:p><text:p text:style-name="Normal">Guardian pages:</text:p><text:list text:style-name="LFO1" text:continue-numbering="true"><text:list-item><text:p text:style-name="ListBullet">Student Switcher: if guardian has multiple students, provide dropdown to choose active student context.</text:p></text:list-item><text:list-item><text:p text:style-name="ListBullet">Homework Status: same as student view but read-only by default.</text:p></text:list-item><text:list-item><text:p text:style-name="ListBullet">Announcements Feed and Documents: scoped to active student where applicable.</text:p></text:list-item></text:list><text:p text:style-name="Normal"><text:span text:style-name="T32">8) File Upload &amp; Download UX</text:span></text:p><text:p text:style-name="Normal"><text:span text:style-name="T33">Upload rules</text:span></text:p><text:list text:style-name="LFO1" text:continue-numbering="true"><text:list-item><text:p text:style-name="ListBullet">Use a drag-and-drop uploader with progress bar and cancel.</text:p></text:list-item><text:list-item><text:p text:style-name="ListBullet">Allow multiple attachments; show accepted types and max size configured by backend.</text:p></text:list-item><text:list-item><text:p text:style-name="ListBullet">Validate filename length and type client-side, but rely on backend validation.</text:p></text:list-item></text:list><text:p text:style-name="Normal"><text:span text:style-name="T34">Download rules</text:span></text:p><text:list text:style-name="LFO1" text:continue-numbering="true"><text:list-item><text:p text:style-name="ListBullet">Downloads must use authorized endpoints; do not construct direct object-storage URLs unless backend provides short-lived signed URLs.</text:p></text:list-item><text:list-item><text:p text:style-name="ListBullet">For protected downloads, open in new tab or force download depending on file type.</text:p></text:list-item><text:list-item><text:p text:style-name="ListBullet">Log download attempt errors and display friendly messages.</text:p></text:list-item></text:list><text:p text:style-name="Normal"><text:span text:style-name="T35">9) Responsive Design Requirements</text:span></text:p><text:p text:style-name="Normal"><text:span text:style-name="T36">Layouts</text:span></text:p><text:list text:style-name="LFO1" text:continue-numbering="true"><text:list-item><text:p text:style-name="ListBullet">AppShell: side-nav on desktop; collapsible drawer on tablet; bottom nav or hamburger on mobile.</text:p></text:list-item><text:list-item><text:p text:style-name="ListBullet">Tables: on small screens, use card layouts or responsive table patterns (stacked rows).</text:p></text:list-item><text:list-item><text:p text:style-name="ListBullet">Forms: single-column on mobile; two-column on desktop where appropriate.</text:p></text:list-item><text:list-item><text:p text:style-name="ListBullet">Touch targets: buttons at least ~44px height.</text:p></text:list-item></text:list><text:p text:style-name="Normal"><text:span text:style-name="T37">Key mobile screens</text:span></text:p><text:list text:style-name="LFO1" text:continue-numbering="true"><text:list-item><text:p text:style-name="ListBullet">Login</text:p></text:list-item><text:list-item><text:p text:style-name="ListBullet">Homework list</text:p></text:list-item><text:list-item><text:p text:style-name="ListBullet">Homework detail</text:p></text:list-item><text:list-item><text:p text:style-name="ListBullet">Submit homework</text:p></text:list-item><text:list-item><text:p text:style-name="ListBullet">Announcements feed</text:p></text:list-item><text:list-item><text:p text:style-name="ListBullet">Documents list</text:p></text:list-item></text:list><text:p text:style-name="Normal"><text:span text:style-name="T38">10) State Management &amp; Caching (MVP vs Later)</text:span></text:p><text:list text:style-name="LFO1" text:continue-numbering="true"><text:list-item><text:p text:style-name="ListBullet">MVP: use services with RxJS BehaviorSubject for auth state and selected student context.</text:p></text:list-item><text:list-item><text:p text:style-name="ListBullet">Optional later: NgRx for complex state (quizzes, multi-page flows) if needed.</text:p></text:list-item><text:list-item><text:p text:style-name="ListBullet">Cache small lists (announcements, classes) with a short TTL to reduce API calls.</text:p></text:list-item></text:list><text:p text:style-name="Normal"><text:span text:style-name="T39">11) Testing Guidelines</text:span></text:p><text:p text:style-name="Normal"><text:span text:style-name="T40">Unit tests</text:span></text:p><text:list text:style-name="LFO1" text:continue-numbering="true"><text:list-item><text:p text:style-name="ListBullet">AuthService (login/refresh/logout flows).</text:p></text:list-item><text:list-item><text:p text:style-name="ListBullet">Guards (role checks, auth checks).</text:p></text:list-item><text:list-item><text:p text:style-name="ListBullet">Feature services (API integration, error mapping).</text:p></text:list-item></text:list><text:p text:style-name="Normal"><text:span text:style-name="T41">E2E tests (optional)</text:span></text:p><text:list text:style-name="LFO1" text:continue-numbering="true"><text:list-item><text:p text:style-name="ListBullet">Login as each role → correct dashboard.</text:p></text:list-item><text:list-item><text:p text:style-name="ListBullet">Teacher creates homework → student sees it.</text:p></text:list-item><text:list-item><text:p text:style-name="ListBullet">Student submits homework → teacher sees submission.</text:p></text:list-item><text:list-item><text:p text:style-name="ListBullet">Guardian switches student context → correct data shown.</text:p></text:list-item></text:list><text:p text:style-name="Normal"><text:span text:style-name="T42">12) Copilot Prompts (Frontend)</text:span></text:p><text:p text:style-name="Normal">Use these prompts in Copilot Chat. Keep the spec file open so Copilot can reference it.</text:p><text:list text:style-name="LFO5" text:continue-numbering="true"><text:list-item><text:p text:style-name="ListNumber">Generate an Angular app shell with responsive navigation (side nav desktop, drawer mobile) and role-based menu items for ADMIN/TEACHER/STUDENT/GUARDIAN.</text:p></text:list-item><text:list-item><text:p text:style-name="ListNumber">Generate AuthService + TokenInterceptor + AuthGuard + RoleGuard for JWT access token and refresh on 401. Include secure token storage notes.</text:p></text:list-item><text:list-item><text:p text:style-name="ListNumber">Generate Teacher homework feature module: homework list + create form + detail page using reactive forms and a HomeworkService calling the backend endpoints.</text:p></text:list-item><text:list-item><text:p text:style-name="ListNumber">Generate Student homework feature pages: homework list + homework detail + submission form with file upload and progress, and connect to backend endpoints.</text:p></text:list-item><text:list-item><text:p text:style-name="ListNumber">Generate Guardian student switcher (selected student context service) and reuse student homework components in read-only mode.</text:p></text:list-item><text:list-item><text:p text:style-name="ListNumber">Generate shared components: loading spinner, confirm dialog, toast/snackbar notification service, and a global API error mapper.</text:p></text:list-item></text:list><text:p text:style-name="Normal"><text:span text:style-name="T43">13) Environment &amp; Config</text:span></text:p><text:list text:style-name="LFO1" text:continue-numbering="true"><text:list-item><text:p text:style-name="ListBullet">environment.ts contains apiBaseUrl (e.g., http://localhost:8080).</text:p></text:list-item><text:list-item><text:p text:style-name="ListBullet">Build uses separate configs for dev/prod.</text:p></text:list-item><text:list-item><text:p text:style-name="ListBullet">Feature flags optional (enable quizzes after phase 1).</text:p></text:list-item></text:list><text:p text:style-name="Normal"><text:span text:style-name="T44">14) MVP Acceptance Criteria (Frontend)</text:span></text:p><text:list text:style-name="LFO1" text:continue-numbering="true"><text:list-item><text:p text:style-name="ListBullet">User can login and is routed to correct dashboard based on role.</text:p></text:list-item><text:list-item><text:p text:style-name="ListBullet">Protected routes cannot be accessed without correct role.</text:p></text:list-item><text:list-item><text:p text:style-name="ListBullet">Teacher can create homework and view homework list.</text:p></text:list-item><text:list-item><text:p text:style-name="ListBullet">Student can view homework list/detail and submit a submission with optional files.</text:p></text:list-item><text:list-item><text:p text:style-name="ListBullet">Guardian can select a linked student and view that student’s homework status.</text:p></text:list-item><text:list-item><text:p text:style-name="ListBullet">Announcements and documents are viewable/downloadable with proper authorization handling.</text:p></text:list-item><text:list-item><text:p text:style-name="ListBullet">Error handling shows meaningful messages; loading states implemented.</text:p></text:list-item></text:list></office:text></office:body></office:document-content>